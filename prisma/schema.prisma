// Production Prisma Schema for Cloud Music Streaming Platform (Spotify Architecture)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

enum Role {
  USER
  ARTIST
  ADMIN
}

enum PlaylistVisibility {
  PUBLIC
  PRIVATE
  COLLABORATIVE
}

enum AudioCodec {
  MP3_320
  AAC_256
  FLAC_LOSSLESS
  WAV_PCM
}

model User {
  id              String             @id @default(uuid()) @db.Uuid
  email           String             @unique @db.VarChar(255)
  passwordHash    String?            @map("password_hash") @db.VarChar(255)
  displayName     String             @map("display_name") @db.VarChar(100)
  avatarUrl       String?            @map("avatar_url") @db.Text
  role            Role               @default(USER)
  isPremium       Boolean            @default(false) @map("is_premium")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  // Relationships
  playlists       Playlist[]
  likes           Like[]
  playbackHistory PlaybackHistory[]
  followedArtists ArtistFollower[]
  playlistFollows PlaylistFollower[]
  refreshTokens   RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Artist {
  id               String           @id @default(uuid()) @db.Uuid
  name             String           @db.VarChar(150)
  bio              String?          @db.Text
  avatarUrl        String?          @map("avatar_url") @db.Text
  bannerUrl        String?          @map("banner_url") @db.Text
  monthlyListeners BigInt           @default(0) @map("monthly_listeners")
  isVerified       Boolean          @default(false) @map("is_verified")
  createdAt        DateTime         @default(now()) @map("created_at")

  // Relationships
  albums           Album[]
  tracks           Track[]
  followers        ArtistFollower[]

  @@index([name])
  @@index([monthlyListeners(sort: Desc)])
  @@map("artists")
}

model ArtistFollower {
  userId    String   @map("user_id") @db.Uuid
  artistId  String   @map("artist_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([userId, artistId])
  @@map("artist_followers")
}

model Album {
  id          String    @id @default(uuid()) @db.Uuid
  artistId    String    @map("artist_id") @db.Uuid
  title       String    @db.VarChar(200)
  coverUrl    String?   @map("cover_url") @db.Text
  releaseDate DateTime  @map("release_date") @db.Date
  genre       String    @db.VarChar(50)
  totalTracks Int       @default(0) @map("total_tracks")
  createdAt   DateTime  @default(now()) @map("created_at")

  artist      Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tracks      Track[]

  @@index([artistId])
  @@index([releaseDate(sort: Desc)])
  @@map("albums")
}

model Track {
  id              String            @id @default(uuid()) @db.Uuid
  artistId        String            @map("artist_id") @db.Uuid
  albumId         String?           @map("album_id") @db.Uuid
  title           String            @db.VarChar(200)
  durationSeconds Int               @map("duration_seconds")
  trackNumber     Int?              @map("track_number")
  discNumber      Int?              @default(1) @map("disc_number")
  audioUrl        String            @map("audio_url") @db.Text
  audioFileKey    String            @map("audio_file_key") @db.VarChar(500)
  audioFileSize   BigInt            @map("audio_file_size")
  codec           AudioCodec        @default(MP3_320)
  bpm             Int?
  genre           String            @db.VarChar(50)
  lyricsLrc       String?           @map("lyrics_lrc") @db.Text
  playsCount      BigInt            @default(0) @map("plays_count")
  createdAt       DateTime          @default(now()) @map("created_at")

  artist          Artist            @relation(fields: [artistId], references: [id], onDelete: Cascade)
  album           Album?            @relation(fields: [albumId], references: [id], onDelete: SetNull)
  playlistTracks  PlaylistTrack[]
  likes           Like[]
  playbackHistory PlaybackHistory[]

  @@index([artistId])
  @@index([albumId])
  @@index([genre])
  @@index([playsCount(sort: Desc)])
  @@map("tracks")
}

model Playlist {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  title       String             @db.VarChar(150)
  description String?            @db.Text
  coverUrl    String?            @map("cover_url") @db.Text
  visibility  PlaylistVisibility @default(PUBLIC)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks      PlaylistTrack[]
  followers   PlaylistFollower[]

  @@index([userId])
  @@map("playlists")
}

model PlaylistTrack {
  id         String   @id @default(uuid()) @db.Uuid
  playlistId String   @map("playlist_id") @db.Uuid
  trackId    String   @map("track_id") @db.Uuid
  position   Int
  addedAt    DateTime @default(now()) @map("added_at")

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, position])
  @@index([playlistId])
  @@index([trackId])
  @@map("playlist_tracks")
}

model PlaylistFollower {
  userId     String   @map("user_id") @db.Uuid
  playlistId String   @map("playlist_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@id([userId, playlistId])
  @@map("playlist_followers")
}

model Like {
  userId    String   @map("user_id") @db.Uuid
  trackId   String   @map("track_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([userId, trackId])
  @@index([userId])
  @@index([trackId])
  @@map("likes")
}

model PlaybackHistory {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  trackId              String   @map("track_id") @db.Uuid
  playedAt             DateTime @default(now()) @map("played_at")
  completionPercentage Float    @default(1.0) @map("completion_percentage")
  durationListenedSec  Int      @default(0) @map("duration_listened_sec")

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track                Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([userId, playedAt(sort: Desc)])
  @@index([trackId])
  @@map("playback_history")
}
